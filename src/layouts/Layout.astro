---
import "@/assets/css/globals.css";
import DocumentLayout from "./DocumentLayout.astro";

export interface Props {
  title: string;
  description?: string;
  type?: "website" | "article" | "profile";
  publishedTime?: string | number | Date;
}

const { title, description, type, publishedTime } = Astro.props;
---

<DocumentLayout title={title} description={description} type={type} publishedTime={publishedTime}>
  <slot />
</DocumentLayout>

<style is:global>
  body {
    margin: 0;
    background: #000;
    color: var(--accent-color);
    line-height: 1.4;
  }

  a {
    color: var(--accent-color);
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  a:hover {
    background: var(--accent-color);
    color: #000;
  }

  main {
    margin: 0 auto;
  }

  blockquote {
    background: #1f1f1f;
    border-left: 8px solid #303030;
    margin: 16px 0;
    padding: 16px;
  }

  /* rendered by markdown > */
  blockquote > p {
    margin: 0;
    padding: 0;
  }

  /* rendered with markdown ``` */
  .astro-code {
    padding: 8px;
  }

  /* rendered by markdown ` */
  .content :not(.astro-code) > code {
    background: #1a1a1a;
    color: #4ecdc4;
    padding: 0.2rem 0.4rem;
    font-family: "Courier New", monospace;
    font-size: 0.9em;
    border: 1px solid #333;
    border-radius: 0;
  }
</style>
