---
import Layout from "@/layouts/Layout.astro";
import { formatDate } from "@/utils/date";

const introLinks = {
  projects: "/from-scratch",
  blogs: "/posts",
  books: "https://www.goodreads.com/user/show/189947877-biraj",
};

const navLinks = [
  { href: "https://x.com/biraj21_", label: "twitter", external: true },
  { href: "/resume", label: "resume" },
  { href: "/posts", label: "blog" },
  { href: "/from-scratch", label: "projects" },
  { href: "https://github.com/biraj21", label: "github", external: true },
  { href: "mailto:biraj.pub@gmail.com", label: "email" },
  { href: "/arrayvis", label: "visualize tensors" },
  { href: "/rejections", label: "rejections" },
];

const allPosts = Object.values(import.meta.glob("./posts/*.md", { eager: true }));

const posts = allPosts
  .filter((post) => !post.url?.includes(".draft"))
  .sort((a, b) => new Date(b.frontmatter.pubDate).getTime() - new Date(a.frontmatter.pubDate).getTime())
  .slice(0, 2)
  .map((post) => ({
    ...post,
    formattedDate: formatDate(post.frontmatter.pubDate),
  }));
---

<Layout
  title="Biraj | Full-Stack Engineer"
  description="Biraj is a founder and full-stack engineer building backend systems, developer tools, and products like Shellular."
>
  <main class="home">
    <h1>biraj</h1>

    <hr class="thick" />

    <section class="intro">
      <img src="/images/me.jpeg" alt="Biraj" class="profile-image" />

      <p>
        i sometimes build things <a href={introLinks.projects}>from scratch</a>, play chess (1900 rapid on <a
          href="https://lichess.org/@/biraj21"
          target="_blank"
          rel="noreferrer">Lichess</a
        >), play badminton, and read <a href={introLinks.books} target="_blank" rel="noreferrer">books</a>.
      </p>

      <p>currently fucking around, hoping for the divine find out.</p>
    </section>

    <section class="currently-exploring">
      <h2>$ currently exploring</h2>

      <hr />

      <p>
        building <a href="https://shellular.dev/" target="_blank" rel="noreferrer">Shellular</a>, which lets you use
        your dev environment from your phone. here's
        <a href="https://youtu.be/5OiZvayop0I?si=tNiOWOrtETbN0re0" target="_blank">the demo</a>.
      </p>

      <p>
        also some other random things, which you can find on my <a
          href="https://github.com/biraj21"
          target="_blank"
          rel="noreferrer">GitHub</a
        >.
      </p>
    </section>

    <section class="programs">
      <h2>$ programs</h2>

      <hr />

      <ul class="home-list programs-list">
        <li>
          <a href="https://f.inc/" target="_blank" rel="noreferrer">Founders Inc Off Season II</a>
          <span>San Francisco</span>
        </li>
        <li>
          <a href="https://lossfunk.com/residency/" target="_blank" rel="noreferrer">Lossfunk Residency, Batch 6</a>
          <span>Bangalore</span>
        </li>
      </ul>
    </section>

    {
      posts.length > 0 && (
        <section class="latest-posts">
          <h2>$ latest posts</h2>
          <hr />
          <ul class="home-list latest-posts-list">
            {posts.map((post) => (
              <li>
                <a href={post.url}>{post.frontmatter.title}</a>
                <span class="post-date">{post.formattedDate}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <hr />

    <nav class="home-nav" aria-label="Primary">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noreferrer" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </main>

  <style>
    .home {
      max-width: 600px;
      margin: 0 auto;
      padding: 3rem 1rem;
      line-height: 1.6;
      text-align: left;
    }

    .home h1 {
      font-size: 1.8rem;
      margin-bottom: 0;
      font-weight: normal;
    }

    .home hr {
      border: none;
      border-top: 1px solid var(--accent-color);
      margin: 1rem 0;
    }

    .home hr.thick {
      border-top-width: 2px;
    }

    .intro {
      position: relative;
    }

    .profile-image {
      width: 120px;
      height: 120px;
      border-radius: 50%;
      object-fit: cover;
      float: right;
      margin-left: 1.5rem;
      margin-bottom: 1rem;
      shape-outside: circle(50%);
    }

    .home p {
      font-size: 0.95rem;
      margin-bottom: 1rem;
    }

    .home-list {
      list-style: none;
      padding: 0;
      margin: 0;
      font-size: 0.95rem;
    }

    .home-list li {
      padding-left: 1rem;
      position: relative;
    }

    .home-list li::before {
      content: "-";
      position: absolute;
      left: 0;
      color: var(--accent-color);
    }

    .programs-list li {
      margin-bottom: 0.4rem;
    }

    .programs-list span {
      color: #666;
    }

    .programs-list span::before {
      content: " / ";
    }

    .home section + section {
      margin-top: 2rem;
    }

    .home h2 {
      font-size: 1.2rem;
      margin-bottom: 0;
      font-weight: normal;
    }

    .latest-posts-list li {
      margin-bottom: 0.5rem;
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 1rem;
    }

    .latest-posts .post-date {
      color: #666;
      font-size: 0.85rem;
      white-space: nowrap;
    }

    .home-nav a {
      display: inline-block;
      margin-right: 1rem;
      margin-bottom: 0.5rem;
      padding: 0.2rem 0.5rem;
      border: 1px solid var(--accent-color);
      text-decoration: none;
      font-family: inherit;
    }

    @media (max-width: 600px) {
      body {
        padding: 1rem;
      }

      .home {
        padding: 1rem;
      }

      .profile-image {
        width: 100px;
        height: 100px;
        margin-left: 1rem;
      }

      .home h1 {
        font-size: 1.3rem;
      }

      .home h2 {
        font-size: 1.1rem;
      }

      .latest-posts li {
        align-items: flex-start;
        flex-direction: column;
        gap: 0.2rem;
      }

      .programs-list span {
        display: block;
      }

      .programs-list span::before {
        content: none;
      }

      .home-nav a {
        margin-right: 0.5rem;
      }
    }
  </style>
</Layout>
